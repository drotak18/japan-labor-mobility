install.packages(c("tidyverse", "readxl", "janitor"))
library(readxl)
library(tidyverse)
f <- "data/raw/zairyu/24-12-t2.xlsx"
excel_sheets(f)
read_excel(f, sheet = 1, col_names = FALSE, n_max = 12) |>
print(n = 12, width = Inf)
read_excel(f, sheet = "PVT", col_names = FALSE, n_max = 15) |>
print(n = 15, width = Inf)
library(tidyverse)
f <- "data/raw/zairyu/FEH_00250012_260804235215.csv"
d <- read_csv(f, locale = locale(encoding = "SJIS"), n_max = 20)
print(d, width = Inf)
raw <- read_lines(f, locale = locale(encoding = "SJIS"), n_max = 40)
writeLines(raw[20:40])
d <- read_csv(f, locale = locale(encoding = "SJIS"), skip = 26,
col_types = cols(.default = col_character()))
names(d)
nrow(d)
count(d, 国籍07)
count(d, `時間軸（月次）`)
library(janitor)
panel <- d |>
select(area_code, 市区町村, 国籍07, `時間軸（月次）`, value) |>
set_names(c("muni_code", "muni_name", "nationality", "period", "value")) |>
mutate(
year       = as.integer(str_extract(period, "^\\d{4}")),
month      = as.integer(str_extract(period, "(?<=年)\\d+")),
pref_code  = str_sub(muni_code, 1, 2),
suppressed = value == "-",
count      = if_else(suppressed, NA_real_, as.numeric(value)),
nationality = if_else(nationality == "ブラジル", "brazil", "total")
) |>
select(-value, -period) |>
pivot_wider(names_from = nationality, values_from = c(count, suppressed))
tokai <- panel |> filter(pref_code %in% c("10", "21", "22", "23", "24", "25"))
nrow(tokai)
tokai |> filter(month == 12, year %in% c(2012, 2016)) |>
group_by(year) |>
summarise(munis = n(), brazil = sum(count_brazil, na.rm = TRUE),
suppressed = sum(suppressed_brazil))
chg <- tokai |>
filter(month == 12, year %in% c(2012, 2016)) |>
select(muni_code, muni_name, year, count_brazil) |>
pivot_wider(names_from = year, values_from = count_brazil,
names_prefix = "y") |>
filter(!is.na(y2012), !is.na(y2016), y2012 >= 50) |>
mutate(pct = 100 * (y2016 - y2012) / y2012)
nrow(chg)
summary(chg$pct)
chg |> arrange(desc(pct)) |> head(8)
chg |> arrange(pct) |> head(8)
dir.create("src")
source("~/projects/japan-labor-mobility/src/01_load_zairyu.R")
readme <- read_lines("README.md")
readme[length(readme) - 2] <- "Sample: Aichi, Shizuoka, Gifu, Mie, Gunma, Shiga. The e-Stat database view of table 07 covers ten semiannual waves, 2012年12月 to 2017年6月, 240 municipalities in these prefectures. Extending to 2024 requires either the per-wave Excel files or the e-Stat API. All data are public."
readme[length(readme)] <- "Status: panel loaded. Aggregate Brazilian population in the six prefectures fell only 4.6% between 2012 and 2016 (141,132 to 134,666), but municipality-level changes ranged from -44% to +92% with an interquartile range of -15% to +6%. The spatial redistribution is large even where the aggregate is flat, which is the variation the design exploits. Next: base-period industry shares from 工業統計調査 and a merger crosswalk to fixed geography."
write_lines(readme, "README.md")
